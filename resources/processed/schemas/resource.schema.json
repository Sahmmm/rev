{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/rev/resource.schema.json",
  "title": "Resource",
  "type": "object",
  "required": ["id", "title", "type", "path", "topics", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["course", "exam", "tp", "personal-note"]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["raw", "processed", "reviewed"]
    },
    "notes": {
      "type": "string"
    }
  }
}
